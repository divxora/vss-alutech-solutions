# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite Client - Publicly safe)
# Set in GitHub Repository Secrets or .env.local for development
# ------------------------------------------------------------------------------
VITE_BASE_PATH=/vss-alutech-solutions/
VITE_SUPABASE_URL=https://cvamnocsfuanbwbljblm.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-public-publishable-anon-key...
VITE_SUBMIT_ENQUIRY_URL=https://cvamnocsfuanbwbljblm.supabase.co/functions/v1/submit-enquiry

# ------------------------------------------------------------------------------
# BACKEND SUPABASE SECRETS (Set inside Supabase Dashboard > Edge Functions > Secrets)
# NEVER put these in Vite .env or public GitHub repositories!
# ------------------------------------------------------------------------------
# 1. Supabase Service Role Key (allows Edge Function to insert into RLS-protected tables)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-secret-service-role-key...

# 2. Resend API Key for Transactional Email Notifications
RESEND_API_KEY=re_1234567890abcdef...

# 3. Verified Sender Domain & Address in Resend (e.g. notifications@yourdomain.com)
RESEND_FROM_EMAIL=enquiries@vssalutechsolutions.in

# 4. Target Business Notification Inbox (where enquiries are received)
BUSINESS_NOTIFICATION_EMAIL=info@vsslutechsolutions.in
