# ==============================================================================
# VSS Alutech Solutions — Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE.JS & EXPRESS SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Path to SQLite database file (defaults to data/vss_alutech.sqlite)
SQLITE_DB_PATH=data/vss_alutech.sqlite

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# High-entropy secret key for signing JWT tokens (generate a 64+ char random string in production)
JWT_SECRET=vss_alutech_enterprise_production_jwt_secret_key_change_in_production!
JWT_EXPIRES_IN=24h

# Default administrator credentials (Leave ADMIN_DEFAULT_PASSWORD blank to use the secure in-browser first-time setup at #admin-login)
ADMIN_DEFAULT_EMAIL=admin@vsslutechsolutions.in
# ADMIN_DEFAULT_PASSWORD=SetYourStrongPasswordHere!

# ------------------------------------------------------------------------------
# 3. EMAIL NOTIFICATIONS (NODEMAILER SMTP)
# ------------------------------------------------------------------------------
# Notifications will be sent to the business administrator upon form submission
ADMIN_NOTIFICATION_EMAIL=info@vsslutechsolutions.in

# Outgoing SMTP Server Configuration (e.g., Google Workspace, AWS SES, Hostinger, Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@vsslutechsolutions.in
SMTP_PASS=your-secure-app-password
SMTP_FROM="VSS Alutech Solutions" <info@vsslutechsolutions.in>

# Note: In development mode, if SMTP is left unconfigured, Nodemailer operates in
# safe simulation mode without throwing errors, logging message IDs to server console.

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Vite Client - Publicly Safe)
# ------------------------------------------------------------------------------
VITE_BASE_PATH=/vss-alutech-solutions/
VITE_SUPABASE_URL=https://cvamnocsfuanbwbljblm.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-public-publishable-anon-key...
VITE_SUBMIT_ENQUIRY_URL=https://cvamnocsfuanbwbljblm.supabase.co/functions/v1/submit-enquiry

# ------------------------------------------------------------------------------
# 5. SUPABASE SECRETS (Optional cloud sync if using Supabase Edge Functions)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://cvamnocsfuanbwbljblm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
RESEND_API_KEY=re_1234567890abcdef
RESEND_FROM_EMAIL=enquiries@vsslutechsolutions.in
BUSINESS_NOTIFICATION_EMAIL=info@vsslutechsolutions.in
